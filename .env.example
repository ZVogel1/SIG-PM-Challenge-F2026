# Create an API key at: https://sig.thesuper.market → Settings → API Keys
# Required scopes: read, trade
SUPERMARKET_API_KEY=your_api_key_here

# Base URL (default is production). Confirm with: pmcup whoami
SUPERMARKET_API_BASE=https://www.thesuper.market/api/v1

# Tournament slug (discover with: python -m pmcup tournaments)
TOURNAMENT_SLUG=midterm-elections

# Safety latches for live orders (BOTH required to place real trades)
DRY_RUN=true
LIVE_TRADING=false
# Also refuse live orders outside Oct 1–Nov 4 2026 12:00 ET
ENFORCE_TRADING_WINDOW=true

# Aggressive sizing for maximizing chance of #1 (1.0 = Kelly, 1.5–2.0 = tournament mode)
TOURNAMENT_KELLY_MULT=1.75

# Only surface trades with at least this much edge (absolute probability gap)
MIN_EDGE=0.04

# Max fraction of bankroll in any single market / race (portfolio-aware)
MAX_POSITION_FRAC=0.25
MAX_RACE_EXPOSURE_FRAC=0.25

# HTTP resilience
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_S=0.75

# --- Unattended bots ---
# How often bots re-scan and decide (seconds). 180 = every 3 minutes.
BOT_INTERVAL_SECONDS=180
# Max orders submitted each cycle across all bots
BOT_MAX_ORDERS_PER_CYCLE=5
# Refresh VotePredictor forecasts every N cycles (10 * 180s ≈ 30 min)
BOT_REFRESH_FORECASTS_EVERY_N=10
BOT_ENABLE_EDGE=true
BOT_ENABLE_CONSTRAINT=true
BOT_ENABLE_RISK=true
# Exit when net edge falls below this / take profit threshold
BOT_EXIT_NET_EDGE=0.01
BOT_TAKE_PROFIT_FRAC=0.35
# Sell when underwater and no scan idea exists for the position
BOT_UNDERWATER_EXIT_FRAC=-0.20
# Keep running after failures; email after this many consecutive fails
BOT_FAIL_NOTIFY_STREAK=3
BOT_FAIL_BACKOFF_S=60
# FLB heuristic without a fair_probs row: paper OK, live blocked by default
ALLOW_FLB_PAPER=true
ALLOW_FLB_LIVE=false
# Protect rows with source=manual|user|locked or locked=true from auto overwrite
PROTECT_MANUAL_FAIR_PROBS=true
BOT_STATUS_STALE_SECONDS=600

# Email alerts (stop + cycle/order failures)
NOTIFY_ON_STOP=true
NOTIFY_ON_ERRORS=true
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_FROM=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
