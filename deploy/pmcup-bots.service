[Unit]
Description=Predictions Cup multi-bot runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/SIG-PM-Challenge-F2026
Environment=PYTHONPATH=/home/azureuser/SIG-PM-Challenge-F2026/src
ExecStart=/home/azureuser/SIG-PM-Challenge-F2026/.venv/bin/python -m pmcup.bots.daemon
Restart=always
RestartSec=10
# Don't buffer Python logs
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
